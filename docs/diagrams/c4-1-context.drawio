<mxfile host="app.diagrams.net"><diagram id="c4-1-context" name="C4 · Уровень 1 · Контекст системы"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="user" value="&lt;font style=&quot;font-size: 23px&quot;&gt;&lt;b&gt;Пользователь&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Person]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 16px&quot;&gt;&lt;font color=&quot;#d9ecf8&quot;&gt;Входит в ваше приложение через Госуслуги&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;" style="shape=mxgraph.c4.person2;align=center;whiteSpace=wrap;html=1;fillColor=#08427B;fontColor=#FFFFFF;strokeColor=#06315C;fontSize=17;metaEdit=1;points=[[0.5,0,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0]];" vertex="1" parent="1"><mxGeometry x="38" y="412" width="312" height="288" as="geometry"/></mxCell><mxCell id="admin" value="&lt;font style=&quot;font-size: 23px&quot;&gt;&lt;b&gt;Администратор ИС&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Person]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 16px&quot;&gt;&lt;font color=&quot;#d9ecf8&quot;&gt;Разворачивает сервис, настраивает ключ и сертификаты&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;" style="shape=mxgraph.c4.person2;align=center;whiteSpace=wrap;html=1;fillColor=#08427B;fontColor=#FFFFFF;strokeColor=#06315C;fontSize=17;metaEdit=1;points=[[0.5,0,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0]];" vertex="1" parent="1"><mxGeometry x="588" y="0" width="325" height="275" as="geometry"/></mxCell><mxCell id="sys" value="&lt;font style=&quot;font-size: 26px&quot;&gt;&lt;b&gt;ESIA OAuth2 Callback&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Software System]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 18px&quot;&gt;&lt;font color=&quot;#d9ecf8&quot;&gt;Вход через ЕСИА с ГОСТ-подписью и проверенным ID token, получает ФИО и email&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;labelBackgroundColor=none;align=center;whiteSpace=wrap;html=1;fillColor=#1168BD;fontColor=#FFFFFF;strokeColor=#0B4884;fontSize=21;metaEdit=1;points=[[0.5,0,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0]];" vertex="1" parent="1"><mxGeometry x="550" y="475" width="400" height="225" as="geometry"/></mxCell><mxCell id="esia" value="&lt;font style=&quot;font-size: 26px&quot;&gt;&lt;b&gt;ЕСИА&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Software System, Минцифры]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 18px&quot;&gt;&lt;font color=&quot;#d9ecf8&quot;&gt;Аутентификация, выдача токенов, REST API данных пользователя&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;labelBackgroundColor=none;align=center;whiteSpace=wrap;html=1;fillColor=#8B8496;fontColor=#FFFFFF;strokeColor=#6E6879;fontSize=21;metaEdit=1;points=[[0.5,0,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0]];" vertex="1" parent="1"><mxGeometry x="1188" y="475" width="388" height="225" as="geometry"/></mxCell><mxCell id="e0" value="&lt;div style=&quot;text-align: center&quot;&gt;&lt;b&gt;Начинает вход&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align: center&quot;&gt;[HTTPS]&lt;/div&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#707070;strokeWidth=2;fontColor=#404040;fontSize=17;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;jumpStyle=none;exitX=1;exitY=0.68;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="user" target="sys"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e1" value="&lt;div style=&quot;text-align: center&quot;&gt;&lt;b&gt;Подписанные запросы, обмен кода, ФИО и email&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align: center&quot;&gt;[HTTPS / JSON]&lt;/div&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1