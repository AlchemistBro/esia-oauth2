070;strokeWidth=2;fontColor=#404040;fontSize=17;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;jumpStyle=none;exitX=1;exitY=0.62;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="admin" target="esia"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1381" y="170"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>