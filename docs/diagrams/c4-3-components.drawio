<mxfile host="app.diagrams.net"><diagram id="c4-3-components" name="C4 · Уровень 3 · Компоненты Callback-сервиса"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="b" value="&lt;b&gt;Callback-сервис&lt;/b&gt;&lt;div&gt;[Container: Go]&lt;/div&gt;" style="rounded=1;fontSize=21;whiteSpace=wrap;html=1;dashed=1;arcSize=20;fillColor=none;strokeColor=#8A8A8A;fontColor=#333333;labelBackgroundColor=none;align=left;verticalAlign=bottom;labelBorderColor=none;spacingTop=0;spacing=10;dashPattern=8 4;metaEdit=1;rotatable=0" vertex="1" parent="1"><mxGeometry x="362" y="0" width="1088" height="1025" as="geometry"/></mxCell><mxCell id="user" value="&lt;font style=&quot;font-size: 23px&quot;&gt;&lt;b&gt;Пользователь&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Person]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 16px&quot;&gt;&lt;font color=&quot;#d9ecf8&quot;&gt;Браузер&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;" style="shape=mxgraph.c4.person2;align=center;whiteSpace=wrap;html=1;fillColor=#08427B;fontColor=#FFFFFF;strokeColor=#06315C;fontSize=17;metaEdit=1;points=[[0.5,0,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0]];" vertex="1" parent="1"><mxGeometry x="25" y="375" width="275" height="262" as="geometry"/></mxCell><mxCell id="login" value="&lt;font style=&quot;font-size: 26px&quot;&gt;&lt;b&gt;Обработчик входа&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Component: GET /auth/esia/login]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 18px&quot;&gt;&lt;font color=&quot;#d9ecf8&quot;&gt;Создаёт state и ID браузера, ставит cookie __Host-, редирект в ЕСИА&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;labelBackgroundColor=none;align=center;whiteSpace=wrap;html=1;fillColor=#23A2D9;fontColor=#FFFFFF;strokeColor=#0E7DAD;fontSize=21;metaEdit=1;points=[[0.5,0,0],[1,0