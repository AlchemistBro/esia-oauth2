=null&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;labelBackgroundColor=none;align=center;whiteSpace=wrap;html=1;fillColor=#23A2D9;fontColor=#FFFFFF;strokeColor=#0E7DAD;fontSize=21;metaEdit=1;points=[[0.5,0,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0]];" vertex="1" parent="1"><mxGeometry x="875" y="50" width="325" height="212" as="geometry"/></mxCell><mxCell id="valid" value="&lt;font style=&quot;font-size: 26px&quot;&gt;&lt;b&gt;Валидатор ID token&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Component: id_token.go]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 18px&quot;&gt;&lt;font color=&quot;#d9ecf8&quot;&gt;Подпись + alg, typ, iss, aud, sub, exp, nbf, iat&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;labelBackgroundColor=none;align=center;whiteSpace=wrap;html=1;fillColor=#23A2D9;fontColor=#FFFFFF;strokeColor=#0E7DAD;fontSize=21;metaEdit=1;points=[[0.5,0,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0]];" vertex="1" parent="1"><mxGeometry x="875" y="412" width="325" height="200" as="geometry"/></mxCell><mxCell id="rs" value="&lt;font style=&quot;font-size: 26px&quot;&gt;&lt;b&gt;Клиент REST API&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Component: resource_api.go]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 18px&quot;&gt;&lt;font color=&quot;#d9ecf8&quot;&gt;ФИО: /rs/prns, email: /rs/prns/ctts&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;labelBackgroundColor=none;align=center;whiteSpace=wrap;html=1;fillColor=#23A2D9;fontColor=#FFFFFF;strokeColor=#0E7DAD;fontSize=21;metaEdit=1;points=[[0.5,0,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0]];" vertex="1" parent="1"><mxGeometry x="875" y="775" width="325" height="188" as="geometry"/></mxCell><mxCell id="csp" value="&lt;font style=&quot;font-size: 26px&quot;&gt;&lt;b&gt;КриптоПро CSP&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Container: csptest]&lt;/div&gt;